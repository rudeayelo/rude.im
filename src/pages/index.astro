---
import SiteLogo from "../components/SiteLogo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

const pageTitle = "Rude Ayelo / Experiments";
const pageDescription =
  "A lightweight personal hub for frontend, UX and web platform experiments by Rude Ayelo.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#111213" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lilex:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("rude-theme");
      const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      const theme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : preferredTheme;
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    </script>
  </head>
  <body>
    <main class="shell" aria-label="Rude Ayelo experiment hub">
      <header class="site-header" aria-label="Site header">
        <a class="site-logo" href="/" aria-label="Rude Ayelo">
          <SiteLogo />
        </a>
        <ThemeToggle />
      </header>

      <p class="intro intro-greeting">Hi — I’m <span>Rude Ayelo</span>.</p>
      <p class="intro intro-statement">
        I lead teams building products at scale, aligning leadership, frontend
        architecture and UX to drive clarity, quality and momentum.
      </p>
      <p class="role"><span>Engineering lead at <a class="g2-link" href="https://g2.com">G2</a></span></p>

      <section class="aside-quote" aria-labelledby="aside-quote-title">
        <h2 id="aside-quote-title">I was once told</h2>
        <figure>
          <blockquote>
            <p>“You’re not rude at all”</p>
          </blockquote>
          <figcaption>Student, Ironhack, 2015</figcaption>
        </figure>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --background: #f4f5f5;
    --text: #001e33;
    --link: #566268;
    --toggle-text: hsl(205, 5%, 35%);
    --toggle-text-hover: #001e33;
    --focus: hsl(205, 90%, 45%);
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --background: #111213;
    --text: #e4e6e7;
    --link: #a7adb0;
    --toggle-text: hsl(205, 5%, 65%);
    --toggle-text-hover: #e4e6e7;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--background);
  }

  body {
    min-height: 100dvh;
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: "Lilex", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  a {
    color: var(--link);
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.14em;
  }

  .shell {
    width: min(1180px, calc(100vw - 32px));
    margin: 0 auto;
    padding: clamp(24px, 5vw, 56px) 0;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-logo {
    --logo-size: 40px;
    display: flex;
    align-items: center;
    color: var(--text);
    width: calc(var(--logo-size) * 1.18);
    height: var(--logo-size);
    text-decoration: none;
  }

  .logo-light {
    display: block;
    width: var(--logo-size);
    height: var(--logo-size);
  }

  .logo-dark {
    display: none;
    width: calc(var(--logo-size) * 1.1786);
    height: var(--logo-size);
  }

  :root[data-theme="dark"] .logo-light {
    display: none;
  }

  :root[data-theme="dark"] .logo-dark {
    display: block;
  }

  @media (min-width: 800px) {
    .site-logo {
      --logo-size: 60px;
    }
  }

  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--toggle-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--toggle-text-hover);
  }

  .theme-toggle:focus {
    outline: none;
    box-shadow: 0 0 0 2px var(--focus);
  }

  .theme-toggle svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .intro {
    max-width: 41ch;
    margin: 0;
    font-size: clamp(0.9rem, 2.54vw, 2.565rem);
    font-weight: 350;
    line-height: 1.3;
    letter-spacing: 0;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .intro-greeting {
    margin-top: 100px;
  }

  .intro-statement {
    margin-top: 72px;
  }

  .role {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 12px);
    margin: 72px 0 0;
    color: var(--text);
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    font-weight: 350;
    line-height: 1.3;
  }

  .role::before {
    content: "";
    flex: 1 1 auto;
    block-size: 1px;
    background: currentColor;
    opacity: 0.35;
  }

  .role span {
    flex: 0 0 auto;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .g2-link {
    color: #ff492c;
  }

  .aside-quote {
    margin-top: 120px;
    max-width: 41ch;
  }

  .aside-quote h2,
  .aside-quote p,
  .aside-quote figure,
  .aside-quote blockquote,
  .aside-quote figcaption {
    margin: 0;
  }

  .aside-quote h2 {
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    font-weight: 350;
    line-height: 1.3;
    letter-spacing: 0;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .aside-quote figure {
    margin-top: 36px;
  }

  .aside-quote blockquote {
    font-style: italic;
  }

  .aside-quote blockquote p {
    font-size: clamp(0.9rem, 2.54vw, 2.565rem);
    font-weight: 350;
    line-height: 1.3;
    letter-spacing: 0;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .aside-quote figcaption {
    margin-top: 36px;
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    font-weight: 350;
    line-height: 1.3;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  @media (max-width: 620px) {
    .shell {
      width: min(100% - 24px, 420px);
      padding-top: 18px;
    }

    .intro-greeting {
      margin-top: 100px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
