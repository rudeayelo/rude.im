---
import "../styles/allo.css";
import "../styles/links.css";
import "../styles/typography.css";

// Drop the Ironhack quote by flipping this to false.
const SHOW_QUOTE = true;

const pageTitle = "Rude Ayelo";
const pageDescription =
  "I lead teams building products at scale, aligning leadership, product vision and UX to drive clarity, quality and momentum.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#181A1B" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <link
      rel="preload"
      href="/fonts/Allo-Rond40-Regular-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <canvas class="background" data-background-canvas aria-hidden="true"></canvas>
    <main class="card type-body">
      <div class="mark">
        <h1 class="logo">
          <span class="logo-mark" role="img" aria-label="Rude Ayelo">
            <span class="logo-fallback"></span>
            <canvas class="logo-canvas" data-logo-canvas></canvas>
          </span>
        </h1>
      </div>
      <div class="copy">
        <p>
          I lead teams building products at scale, aligning leadership, product
          vision and UX to drive clarity, quality and momentum.
        </p>
        <p>Engineering lead at <a href="https://g2.com">G2</a></p>
        {
          SHOW_QUOTE && (
            <figure class="quote">
              <figcaption>I was once told</figcaption>
              <blockquote>
                <p>“You’re not rude at all”</p>
              </blockquote>
              <p>— Ironhack student, 2015</p>
            </figure>
          )
        }
      </div>
    </main>
    <script>
      import "../scripts/home-shaders";
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --background: #181a1b;
    --text: #869399;
    /* Never darker than the text; links.css adds the ↗ so colour isn't the only cue. */
    --link: #a7adb0;
    --link-hover: #e4e6e7;
    --logo-tint: #d6f1ff;
    /* Phones: lettermark width (it bleeds past both edges) and the gap above its visible top. */
    --mark-size-mobile: 140vw;
    --mark-top-mobile: 6svh;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
  }

  a {
    color: var(--link);
  }

  a:hover {
    color: var(--link-hover);
  }

  a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }
</style>

<style>
  /*
   * The background is soft, zoom-blurred cloth and is by far the most
   * expensive layer, so it renders at about half the CSS resolution (a
   * smaller canvas scaled up) whatever the screen density.
   */
  .background {
    --downscale: 2;
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: calc(100% / var(--downscale));
    height: calc(100% / var(--downscale));
    scale: var(--downscale);
    transform-origin: 0 0;
    opacity: 0;
  }

  @media (min-resolution: 1.5dppx) {
    .background {
      --downscale: 3;
    }
  }

  @media (min-resolution: 2dppx) {
    .background {
      --downscale: 4;
    }
  }

  /* Tablet (601–1023 px): mark above, text below. */
  .card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2lh;
    min-height: 100svh;
    padding: 48px 16px;
    /* The logo canvas is twice the mark; its transparent edge mustn't add scroll. */
    overflow-y: clip;
    /* The homepage reads in Allo; .type-body keeps the size and line height. */
    font-family: "Allo", system-ui, sans-serif;
    text-align: center;
  }

  /*
   * The mark's own wrapper: full width, and it clips the mark where it bleeds.
   * It is also the size container the logo canvas is measured against.
   */
  .mark {
    container-type: inline-size;
    display: flex;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    overflow-x: clip;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1lh;
    /* em, not ch: the width must not change when the web font swaps in. */
    max-width: 24.25em;
  }

  .copy p {
    margin: 0;
  }

  /*
   * The layout box is exactly the lettermark (572 × 505); the fallback mark
   * fills it, rotated to match the chrome, so the fallback → chrome swap never
   * moves. Chrome draws the mark relative to its canvas height: at scale 0.55
   * the mark fills this box when the canvas is twice the box tall, and the
   * chrome's look (bevel, doming) depends on that ratio, so the height stays
   * 2×. The width doesn't change the mark, so it is capped at the wrapper:
   * Shaders renders a canvas larger than the viewport at reduced resolution
   * (by viewport ÷ canvas size), and a bleeding mark would otherwise blur.
   */
  .logo {
    --logo-width: clamp(168px, 44vw, 264px);
    position: relative;
    flex: none;
    width: var(--logo-width);
    aspect-ratio: 572 / 505;
    margin: 0;
  }

  .logo-mark {
    position: absolute;
    inset: 0;
  }

  .logo-fallback {
    position: absolute;
    inset: 0;
    background: var(--logo-tint);
    opacity: 0.72;
    mask: url("/brand/logo.svg") center / contain no-repeat;
    rotate: -7deg;
  }

  .logo-canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100cqw, calc(var(--logo-width) * 2));
    height: calc(var(--logo-width) * 2);
    translate: -50% -50%;
    opacity: 0;
    pointer-events: none;
  }

  :root[data-logo-shader="ready"] .logo-canvas,
  :root[data-background-shader="ready"] .background {
    opacity: 1;
  }

  :root[data-logo-shader="ready"] .logo-fallback,
  :root[data-logo-shader="failed"] .logo-canvas,
  :root[data-background-shader="failed"] .background {
    opacity: 0;
  }

  :root[data-logo-shader="failed"] .logo-canvas,
  :root[data-background-shader="failed"] .background {
    visibility: hidden;
  }

  /*
   * Fade only on the way into a shader. Falling back (device loss, failure)
   * is instant, so the flat mark is never fading in over an empty box.
   */
  @media (prefers-reduced-motion: no-preference) {
    :root[data-logo-shader="ready"] .logo-canvas,
    :root[data-logo-shader="ready"] .logo-fallback,
    :root[data-background-shader="ready"] .background {
      transition: opacity 600ms ease;
    }
  }

  .quote {
    margin: 1lh 0 0;
  }

  .quote blockquote {
    margin: 0;
  }

  /* Phones: a huge mark near the top, bleeding past both edges; text below. */
  @media (max-width: 600px) {
    .card {
      justify-content: flex-start;
      gap: 1.5lh;
      /* The 353° rotation lifts the mark ~3.1 % of its width above its box. */
      padding: calc(var(--mark-top-mobile) + var(--mark-size-mobile) * 0.031) 0 48px;
    }

    .logo {
      --logo-width: var(--mark-size-mobile);
    }

    .copy {
      padding: 0 24px;
    }
  }

  /*
   * Desktop, "Pair": mark and text as one centered, contained
   * pair, the text vertically centred on the mark.
   */
  @media (min-width: 1024px) {
    .card {
      display: grid;
      grid-template-columns: minmax(0, 48fr) minmax(0, 52fr);
      align-items: center;
      gap: 0 5vw;
      max-width: 1200px;
      margin: 0 auto;
      padding: 48px 6vw;
      text-align: start;
    }

    /* At most half the viewport tall, so the 2× canvas renders at full resolution. */
    .logo {
      --logo-width: min(34vw, 440px, 50svh);
    }
  }
</style>
