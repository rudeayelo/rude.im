---
import "../styles/links.css";
import "../styles/typography.css";

// Drop the Ironhack quote by flipping this to false.
const SHOW_QUOTE = true;

const pageTitle = "Rude Ayelo";
const pageDescription =
  "I lead teams building products at scale, aligning leadership, product vision and UX to drive clarity, quality and momentum.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#181A1B" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <link
      rel="preload"
      href="/fonts/DepartureMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <canvas class="background" data-background-canvas aria-hidden="true"></canvas>
    <main class="card type-body">
      <h1 class="logo">
        <span class="logo-mark" role="img" aria-label="Rude Ayelo">
          <span class="logo-fallback"></span>
          <canvas class="logo-canvas" data-logo-canvas></canvas>
        </span>
      </h1>
      <p>
        I lead teams building products at scale, aligning leadership, product
        vision and UX to drive clarity, quality and momentum.
      </p>
      <p>Engineering lead at <a href="https://g2.com">G2</a></p>
      {
        SHOW_QUOTE && (
          <figure class="quote">
            <figcaption>I was once told</figcaption>
            <blockquote>
              <p>“You’re not rude at all”</p>
            </blockquote>
            <p>— Ironhack student, 2015</p>
          </figure>
        )
      }
    </main>
    <script>
      import "../scripts/home-shaders";
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --background: #181a1b;
    --text: #e4e6e7;
    --link: #a7adb0;
    --logo-tint: #d6f1ff;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
  }

  a {
    color: var(--link);
  }

  a:hover {
    color: var(--text);
  }

  a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }
</style>

<style>
  /*
   * The background is soft, zoom-blurred cloth and is by far the most
   * expensive layer, so it renders at about half the CSS resolution (a
   * smaller canvas scaled up) whatever the screen density.
   */
  .background {
    --downscale: 2;
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: calc(100% / var(--downscale));
    height: calc(100% / var(--downscale));
    scale: var(--downscale);
    transform-origin: 0 0;
    opacity: 0;
  }

  @media (min-resolution: 1.5dppx) {
    .background {
      --downscale: 3;
    }
  }

  @media (min-resolution: 2dppx) {
    .background {
      --downscale: 4;
    }
  }

  .card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1lh;
    min-height: 100svh;
    /* em, not ch: the width must not change when the web font swaps in. */
    max-width: 24.25em;
    margin: 0 auto;
    padding: 48px 16px;
    overflow-x: clip;
    text-align: center;
  }

  .card p {
    margin: 0;
  }

  /*
   * The layout box is exactly the lettermark (572 × 505). At scale 0.55 the
   * chrome mark covers about half of its canvas, so the canvas is twice the
   * box and overflows it; the bevel and the 353° rotation never clip. The
   * fallback mark is rotated to match, so nothing shifts when either shows.
   */
  .logo {
    --logo-width: clamp(168px, 44vw, 264px);
    position: relative;
    width: var(--logo-width);
    aspect-ratio: 572 / 505;
    margin: 0 0 1lh;
  }

  .logo-mark {
    position: absolute;
    inset: 0;
  }

  .logo-fallback {
    position: absolute;
    inset: 0;
    background: var(--logo-tint);
    opacity: 0.72;
    mask: url("/brand/logo.svg") center / contain no-repeat;
    rotate: -7deg;
  }

  .logo-canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--logo-width) * 2);
    height: calc(var(--logo-width) * 2);
    translate: -50% -50%;
    opacity: 0;
    pointer-events: none;
  }

  :root[data-logo-shader="ready"] .logo-canvas,
  :root[data-background-shader="ready"] .background {
    opacity: 1;
  }

  :root[data-logo-shader="ready"] .logo-fallback,
  :root[data-logo-shader="failed"] .logo-canvas,
  :root[data-background-shader="failed"] .background {
    opacity: 0;
  }

  :root[data-logo-shader="failed"] .logo-canvas,
  :root[data-background-shader="failed"] .background {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .background,
    .logo-canvas,
    .logo-fallback {
      transition: opacity 600ms ease;
    }
  }

  .quote {
    margin: 1lh 0 0;
  }

  .quote blockquote {
    margin: 0;
  }
</style>
