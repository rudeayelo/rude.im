---
const pageTitle = "Rude Ayelo / Experiments";
const pageDescription =
  "A lightweight personal hub for frontend, UX and web platform experiments by Rude Ayelo.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <script is:inline>
      {
        const storageKey = "rude-theme";
        const storedTheme = localStorage.getItem(storageKey);
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        const theme = storedTheme === "light" || storedTheme === "dark"
          ? storedTheme
          : systemTheme;

        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="color-scheme"]').content = theme;
      }
    </script>
  </head>
  <body>
    <main>
      <button id="theme-toggle" type="button">✧ Toggle dark mode</button>
      <p>Hi — I’m Rude Ayelo.</p>
      <p>
        I lead teams building products at scale, aligning leadership, frontend
        architecture and UX to drive clarity, quality and momentum.
      </p>
      <p>Engineering lead at <a href="https://g2.com">G2</a></p>
      <section aria-labelledby="quote-label">
        <p id="quote-label">I was once told</p>
        <blockquote>
          <p>“You’re not rude at all”</p>
          <footer>— Ironhack student, 2015</footer>
        </blockquote>
      </section>
      <pre>│ Flight  │ Destination ↑           │ Departing  │ Gate  │ Status       │
├─────────┼─────────────────────────┼────────────┼───────┼──────────────┤
│ LH789   │ EUR Europa 1            │ 13:45      │ Z23   │ Delayed      │
│ XX123   │ KBA Kuiper Alpha        │ 08:00      │ 22    │ On Time      │</pre>
      <pre>░░░░░░░░░░
▒▒▒▒▒▒▒▒▒▒
▓▓▓▓▓▓▓▓▓▓</pre>
      <section aria-label="Typography size and tracking tests">
        <p class="type-test-120">Rude Ayelo</p>
        <p class="type-test-56">Rude Ayelo</p>
        <p class="type-test-11">Rude Ayelo</p>
      </section>
    </main>
    <script>
      const storageKey = "rude-theme";
      const root = document.documentElement;
      const colorScheme = document.querySelector('meta[name="color-scheme"]');
      const toggle = document.querySelector("#theme-toggle");
      const systemPreference = window.matchMedia("(prefers-color-scheme: dark)");

      const renderToggle = () => {
        const isDark = root.dataset.theme === "dark";
        toggle.textContent = isDark
          ? "✦ Toggle light mode"
          : "✧ Toggle dark mode";
        toggle.setAttribute("aria-pressed", String(isDark));
      };

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        colorScheme.setAttribute("content", theme);
        renderToggle();
      };

      toggle.addEventListener("click", () => {
        const theme = root.dataset.theme === "dark" ? "light" : "dark";

        localStorage.setItem(storageKey, theme);
        applyTheme(theme);
      });

      systemPreference.addEventListener("change", (event) => {
        if (!localStorage.getItem(storageKey)) {
          applyTheme(event.matches ? "dark" : "light");
        }
      });

      renderToggle();
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Departure Mono";
    src: url("/fonts/DepartureMono-Regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  :root {
    color-scheme: light dark;
    --background: #f4f5f5;
    --text: #001e33;
    --link: #566268;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --background: #111213;
      --text: #e4e6e7;
      --link: #a7adb0;
    }
  }

  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --background: #111213;
    --text: #e4e6e7;
    --link: #a7adb0;
  }

  body {
    background: var(--background);
    color: var(--text);
    font-family: "Departure Mono", monospace;
    font-size: 16px;
    font-size-adjust: from-font;
  }

  button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  a {
    color: var(--link);
  }

  pre {
    font-family: inherit;
    font-size: inherit;
  }

  .type-test-120 {
    font-size: 120px;
    letter-spacing: -10px;
  }

  .type-test-56 {
    font-size: 56px;
    letter-spacing: -5px;
  }

  .type-test-11 {
    font-size: 11px;
    text-transform: uppercase;
  }
</style>
