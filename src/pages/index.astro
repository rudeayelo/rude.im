---
import BioTile from "../components/BioTile.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import LogoTile from "../components/LogoTile.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { experiments } from "../data/experiments";

const pageTitle = "Rude Ayelo / Experiments";
const pageDescription =
  "A lightweight personal hub for frontend, UX and web platform experiments by Rude Ayelo.";
const hasSingleExperiment = experiments.length === 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#111213" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="/media/squircle-field.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("rude-theme");
      const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      const theme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : preferredTheme;
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    </script>
  </head>
  <body>
    <main class="shell" aria-label="Rude Ayelo experiment hub">
      <div class="topbar">
        <p>rude.im</p>
        <ThemeToggle />
      </div>

      <section class:list={["grid", { "single-experiment": hasSingleExperiment }]} aria-label="Identity and experiments">
        <LogoTile />
        <BioTile />
        {experiments.map((experiment) => <ExperimentCard experiment={experiment} />)}
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --background: #f4f5f5;
    --surface: #e9ebeb;
    --surface-strong: #dfe2e2;
    --text: #001e33;
    --text-muted: #566064;
    --line: color-mix(in srgb, var(--text), transparent 86%);
    --shadow: 0 22px 70px color-mix(in srgb, var(--text), transparent 90%);
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --background: #111213;
    --surface: #181a1b;
    --surface-strong: #202324;
    --text: #e4e6e7;
    --text-muted: #9aa1a5;
    --line: color-mix(in srgb, var(--text), transparent 86%);
    --shadow: 0 24px 80px color-mix(in srgb, #000, transparent 54%);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--background);
  }

  body {
    min-height: 100dvh;
    margin: 0;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--surface-strong), transparent 50%), transparent 34rem),
      var(--background);
    color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  img,
  video {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  .shell {
    width: min(1180px, calc(100vw - 28px));
    margin: 0 auto;
    padding: clamp(18px, 5vw, 56px) 0;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    margin-bottom: 18px;
    color: var(--text-muted);
  }

  .topbar p {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    padding: 4px 5px 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface), transparent 10%);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .theme-toggle:focus-visible,
  .tile:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .theme-toggle__track {
    position: relative;
    width: 34px;
    height: 22px;
    order: 2;
    border-radius: 999px;
    background: var(--surface-strong);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .theme-toggle__knob {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--text);
    transition: transform 180ms ease;
  }

  :root[data-theme="dark"] .theme-toggle__knob {
    transform: translateX(12px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(210px, auto);
    gap: clamp(10px, 1.8vw, 16px);
  }

  .tile {
    position: relative;
    min-height: 210px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 36px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--text), transparent 95%), transparent),
      var(--surface);
    box-shadow: var(--shadow);
  }

  .logo-tile {
    display: grid;
    place-items: center;
  }

  .logo-tile svg {
    width: clamp(72px, 9vw, 112px);
    height: auto;
  }

  .bio-tile {
    grid-column: span 3;
    display: flex;
    align-items: flex-end;
    padding: clamp(22px, 4vw, 42px);
  }

  .bio-tile p {
    max-width: 19ch;
    margin: 0;
    font-size: clamp(1.5rem, 3.5vw, 3.25rem);
    font-weight: 680;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .experiment-card {
    display: block;
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .experiment-card figure {
    height: 100%;
    min-height: inherit;
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .experiment-card img,
  .experiment-card video {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition: transform 360ms ease, filter 360ms ease;
  }

  .experiment-card figcaption {
    min-height: 82px;
    display: flex;
    align-items: flex-end;
    padding: 18px;
    color: var(--text);
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    font-weight: 700;
    line-height: 1.14;
    background: color-mix(in srgb, var(--surface), transparent 8%);
    border-top: 1px solid var(--line);
  }

  .tile-wide {
    grid-column: span 2;
  }

  .single-experiment .experiment-card {
    grid-column: span 4;
  }

  .tile-large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .archived {
    opacity: 0.62;
  }

  @media (hover: hover) {
    .experiment-card:hover {
      transform: translateY(-5px);
      border-color: color-mix(in srgb, var(--text), transparent 55%);
    }

    .experiment-card:hover img,
    .experiment-card:hover video {
      transform: scale(1.035);
      filter: grayscale(0.12) contrast(1.04);
    }
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(186px, auto);
    }
  }

  @media (max-width: 620px) {
    .shell {
      width: min(100% - 20px, 420px);
      padding-top: 14px;
    }

    .grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .tile,
    .tile-wide,
    .tile-large,
    .single-experiment .experiment-card,
    .bio-tile {
      grid-column: auto;
      grid-row: auto;
      border-radius: 28px;
    }

    .bio-tile {
      min-height: 240px;
    }

    .experiment-card figure {
      min-height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
