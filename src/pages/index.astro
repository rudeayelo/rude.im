---
const pageTitle = "Rude Ayelo / Experiments";
const pageDescription =
  "A lightweight personal hub for frontend, UX and web platform experiments by Rude Ayelo.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <p>Hi — I’m Rude Ayelo.</p>
      <p>
        I lead teams building products at scale, aligning leadership, frontend
        architecture and UX to drive clarity, quality and momentum.
      </p>
      <p>Engineering lead at <a href="https://g2.com">G2</a></p>
      <section aria-labelledby="quote-label">
        <p id="quote-label">I was once told</p>
        <blockquote>
          <p>“You’re not rude at all”</p>
          <footer>— Ironhack student, 2015</footer>
        </blockquote>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Departure Mono";
    src: url("/fonts/DepartureMono-Regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  :root {
    color-scheme: light dark;
    --background: #f4f5f5;
    --text: #001e33;
    --link: #566268;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --background: #111213;
      --text: #e4e6e7;
      --link: #a7adb0;
    }
  }

  body {
    background: var(--background);
    color: var(--text);
    font-family: "Departure Mono", monospace;
    font-size: 16px;
    font-size-adjust: from-font;
  }

  a {
    color: var(--link);
  }
</style>
