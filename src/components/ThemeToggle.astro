<button class="theme-toggle" type="button">
  <svg
    height="24"
    width="24"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8V16Z"
      fill="currentColor"
    />
    <path
      d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM12 4V8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16V20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4Z"
      fill="currentColor"
      fill-rule="evenodd"
    />
  </svg>
  <span class="visually-hidden">Switch theme</span>
</button>

<script>
  const storageKey = "rude-theme";
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

  const getSystemTheme = () =>
    window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

  const applyTheme = (theme: "light" | "dark", explicit = true) => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    toggle?.setAttribute("aria-pressed", String(theme === "dark"));

    if (explicit) {
      localStorage.setItem(storageKey, theme);
    }
  };

  const storedTheme = localStorage.getItem(storageKey);
  const initialTheme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : getSystemTheme();

  applyTheme(initialTheme, false);

  toggle?.addEventListener("click", () => {
    const targetTheme = root.dataset.theme === "light" ? "dark" : "light";

    window.splitbee?.track?.(`Switch to ${targetTheme} theme`);
    applyTheme(targetTheme);
  });
</script>
